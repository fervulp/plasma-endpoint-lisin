#!/usr/bin/env bash
# Install + start LiSin as a systemd USER service, so the EDR is always running
# during the desktop session AND runs in its own dedicated cgroup (which the eBPF
# collector skips to avoid recording the agent's own activity).
#
#   RUN AS YOUR NORMAL USER (not root):   ./packaging/lisin-service
#
# It points the service at the running copy of lisin_app.py: the repo checkout if
# you run it from there, else the installed /usr/share/lisin copy.
set -euo pipefail

[ "$(id -u)" -ne 0 ] || { echo "run as your normal user, NOT root (this is a --user service)"; exit 1; }

# locate lisin_app.py: prefer the repo this script sits in, fall back to /usr/share
HERE="$(cd "$(dirname "$0")/.." && pwd)"
if [ -f "$HERE/lisin_app.py" ]; then
    APP="$HERE/lisin_app.py"
elif [ -f /usr/share/lisin/lisin_app.py ]; then
    APP=/usr/share/lisin/lisin_app.py
else
    echo "cannot find lisin_app.py (looked in $HERE and /usr/share/lisin)"; exit 1
fi
echo "==> app -> $APP"

UNIT_DIR="$HOME/.config/systemd/user"
mkdir -p "$UNIT_DIR"
echo "==> unit -> $UNIT_DIR/lisin.service"
cat > "$UNIT_DIR/lisin.service" <<UNIT
[Unit]
Description=LiSin EDR (lightweight local endpoint detection)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=PYTHONNOUSERSITE=1
Environment=QT_QUICK_CONTROLS_STYLE=org.kde.desktop
ExecStart=/usr/bin/python3 $APP
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
UNIT

# make sure the display is visible to the user manager (KDE/GNOME usually do this
# already; harmless to repeat)
systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XAUTHORITY XDG_RUNTIME_DIR 2>/dev/null || true

systemctl --user daemon-reload
# stop any hand-started instance first (single-instance flock would block the service)
pkill -f "python3 .*lisin_app.py" 2>/dev/null || true
sleep 1
systemctl --user enable --now lisin.service

sleep 2
echo "==> status"
systemctl --user --no-pager --lines=4 status lisin.service || true
CG=$(systemctl --user show -p ControlGroup --value lisin.service 2>/dev/null || true)
echo
echo "cgroup: ${CG:-<not resolved>}"
echo
echo "NEXT: set up the eBPF collector as root so it skips this service's cgroup:"
